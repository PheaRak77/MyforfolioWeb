# Outgoing mailbox. For Gmail, use an App Password (16 characters), not your
# usual Google-account password. Keep the actual .env file private.
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password

# Optional: where website messages are delivered. If omitted, the email address
# of the earliest administrator account in the database is used.
CONTACT_RECIPIENT_EMAIL=your-admin-inbox@gmail.com

# Optional generic SMTP settings. Gmail works without these.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Recommended for Render: Resend uses HTTPS instead of SMTP, avoiding cloud
# SMTP connection timeouts. Create an API key at resend.com and keep it secret.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
